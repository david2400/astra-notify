# Copiar como .env.local y completar. .env.local esta en .gitignore.

# Backend (server -> API). Ver server/lib/env.ts
API_BASE_URL=http://localhost:8081
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_OUTPUT_STANDALONE=false

# notificacion: único backend de notificaciones (administración de canales, envíos por la cola y, por su
# proxy, plantillas e historial de sms_gateway y email_gateway). El frontend ya no llama a los gateways.
NOTIFICACION_API_URL=http://localhost:9001
# Solo si notificacion corre con NOTIFICACION_SECURITY_ENABLED=true: una de NOTIFICACION_ADMIN_API_KEYS
NOTIFICACION_API_KEY=

# access_control (login, usuarios, empresas)
ACCESS_CONTROL_API_URL=http://localhost:8000

# El login es opcional (se entra sin sesión). true = exigir login en todas las páginas.
AUTH_REQUIRED=false

# next-auth: generar con `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET=6f257c79b12131f1638fd0407a3899606f853ed567254a035a3fdd7212e1a742
AUTH_URL=http://localhost:3000

# Login OIDC contra access_control. Sin AUTH_ACCESS_CONTROL_SECRET se usa el login con usuario y contraseña.
# El cliente "astra-notify-web" debe estar registrado en access_control con redirect
# http://localhost:3000/api/auth/callback/access-control
AUTH_ACCESS_CONTROL_ISSUER=http://localhost:8000
AUTH_ACCESS_CONTROL_CLIENT_ID=astra-notify-web
AUTH_ACCESS_CONTROL_SECRET=
